  "description": "Sebenarnya.my design system: tokens, base and component CSS, React components, Tailwind 3.4 preset and lint.",
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "https://github.com/DM3F/sebenarnya.my.git", "directory": "design-system" },
  "type": "module",
